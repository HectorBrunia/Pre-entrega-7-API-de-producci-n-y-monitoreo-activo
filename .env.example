# Copiá este archivo como .env y completá tus claves (el .env NUNCA se sube al repo)

# --- Redis (estado de los jobs, cola de Arq y checkpoints de LangGraph) ---
# Necesita Redis 8 / Redis Stack (módulos JSON + Search). Opciones:
#   docker compose up redis           → redis://localhost:6379/0
#   Redis Cloud (free) → redis://default:<password>@<host>:<puerto>/0   (rediss:// si tiene TLS)
REDIS_URL=redis://localhost:6379/0

# --- LLM (Gemini) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Observabilidad (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=api-agente-produccion
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # solo si tu cuenta es de la región EU

# --- Opcional: RAG híbrido con Pinecone (requiere requirements-rag.txt) ---
PINECONE_API_KEY=
PINECONE_INDEX=techcorp-rag-hibrido
PINECONE_NAMESPACE=orquestador-pe6

# --- Opcionales de operación ---
# WORKER_MAX_JOBS=10
# JOB_TIMEOUT_SECONDS=300
# HITL_UMBRAL_PASOS=6
# CHECKPOINT_TTL_MINUTES=1440
